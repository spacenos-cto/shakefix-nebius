# Nebius Token Factory + NVIDIA Nemotron — copy to .env.nebius and fill MODEL_API_KEY.
# Never commit a real key. .env.nebius is gitignored.

MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL_NAME=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_API_KEY=

# Nemotron-Ultra is a reasoning model: it writes a <think> block before the JSON, so give the
# verdict enough output budget or the reply is cut off and the labeler drops to rules.
PROOF_MAX_TOKENS=8000

# response_format: leave UNSET for Nemotron-Ultra — Token Factory returns HTTP 422 for json_schema
# on this model, and the labeler already strips <think> and extracts the JSON. Some non-reasoning
# models (e.g. openai/gpt-oss-120b) do accept PROOF_RESPONSE_FORMAT=json_schema.
# PROOF_RESPONSE_FORMAT=json_schema

# optional request timeout (ms)
MODEL_TIMEOUT_MS=60000
