{
  "name": "shakefix",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Shake your phone, AI agents on GitLab fix the bug, Second Opinion verifies the fix, production ships it.",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter splitpal dev",
    "proof": "node packages/proof/bin/proof.js",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
