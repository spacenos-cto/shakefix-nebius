exports[`generateSpec snapshots > B1 hero replay (expectation visible) 1`] = `
"// Generated by ShakeFix from report r_20261011_8f3a2b — must FAIL before the fix and PASS after.
// App: splitpal@a1b2c3d · Trigger: shake · Device viewport: 390x844
// Reporter note: settle button does nothing
// Regenerate: node packages/replay/bin/to-spec.js <replay.json> <out.spec.ts> --iid 12
import { test, expect } from '@playwright/test';

test.use({ baseURL: process.env.BASE_URL || "http://localhost:8080" });

test("issue #12: settle button does nothing", async ({ page, request }) => {
  // Reset seeded data (test hooks may be disabled — ignore failures).
  await request.post('/api/__test/reset').catch(() => undefined);
  await page.goto("/");

  // 1. click new-bill-btn
  await page.getByTestId("new-bill-btn").click();

  // 2. navigate → /bill/new
  await page.waitForURL(/^[a-z][a-z0-9+.-]*:\\/\\/[^/]+\\/bill\\/new(?:[?#].*)?$/);

  // 3. input title-input
  await page.getByTestId("title-input").fill("Dinner");

  // 4. input total-input
  await page.getByTestId("total-input").fill("1000");

  // 5. input person-input-0
  await page.getByTestId("person-input-0").fill("Asha");

  // 6. click add-person-btn
  await page.getByTestId("add-person-btn").click();

  // 7. input person-input-1
  await page.getByTestId("person-input-1").fill("Ben");

  // 8. click add-person-btn
  await page.getByTestId("add-person-btn").click();

  // 9. input person-input-2
  await page.getByTestId("person-input-2").fill("Chen");

  // 10. click save-bill-btn
  await page.getByTestId("save-bill-btn").click();

  // 11. submit form — skipped: submit caused by the previous click

  // 12. navigate → /bill/7
  await page.waitForURL(/^[a-z][a-z0-9+.-]*:\\/\\/[^/]+\\/bill\\/[^/?#]+(?:[?#].*)?$/);

  // 13. change tip-select
  await page.getByTestId("tip-select").selectOption("10");

  // 14. click settle-btn
  await page.getByTestId("settle-btn").click();

  // 15. navigate → /bill/7/settle
  await page.waitForURL(/^[a-z][a-z0-9+.-]*:\\/\\/[^/]+\\/bill\\/[^/?#]+\\/settle(?:[?#].*)?$/);

  // 16. click confirm-settle-btn
  await page.getByTestId("confirm-settle-btn").click();

  // Expectation inferred by the SDK: settled-banner visible
  await expect(page.getByTestId("settled-banner")).toBeVisible();
});
"
`;

exports[`generateSpec snapshots > B2 replay (expectation null, masked input, goto, toggle, explicit submit) 1`] = `
"// Generated by ShakeFix from report r_20261012_c0ffee — must FAIL before the fix and PASS after.
// App: splitpal@a1b2c3d · Trigger: auto-error · Device viewport: 412x915
// Reporter note: app went blank * / after I saved with an empty name
// Regenerate: node packages/replay/bin/to-spec.js <replay.json> <out.spec.ts> --iid 13
import { test, expect } from '@playwright/test';

test.use({ baseURL: process.env.BASE_URL || "http://localhost:8080" });

test("issue #13: app went blank */ after I saved with an empty name", async ({ page, request }) => {
  const errors: string[] = [];
  page.on('console', (msg) => { if (msg.type() === 'error' && !/favicon/i.test(msg.text())) errors.push(msg.text()); });
  page.on('pageerror', (err) => errors.push(String(err)));

  // Reset seeded data (test hooks may be disabled — ignore failures).
  await request.post('/api/__test/reset').catch(() => undefined);
  await page.goto("/settings");

  // 1. navigate → /
  await page.goto("/");

  // 2. click new-bill-btn
  await page.getByTestId("new-bill-btn").click();

  // 3. navigate → /bill/new
  await page.waitForURL(/^[a-z][a-z0-9+.-]*:\\/\\/[^/]+\\/bill\\/new(?:[?#].*)?$/);

  // 4. input title-input
  await page.getByTestId("title-input").fill("Lunch \\"team\\"");

  // 5. input #notes (value masked by the SDK — placeholder used)
  await page.locator("#notes").fill("ShakeFix test");

  // 6. input total-input
  await page.getByTestId("total-input").fill("90");

  // 7. input person-input-0
  await page.getByTestId("person-input-0").fill("");

  // 8. change #split-even
  await page.locator("#split-even").setChecked(true);

  // 9. submit main > form
  await page.locator("main > form").evaluate((form) => (form as HTMLFormElement).requestSubmit());

  // 10. navigate → /bill/k3x9a2
  await page.waitForURL(/^[a-z][a-z0-9+.-]*:\\/\\/[^/]+\\/bill\\/[^/?#]+(?:[?#].*)?$/);

  // No expectation recorded: the flow must finish without console errors or an error banner.
  await expect(page.getByTestId('error-banner')).toBeHidden();
  expect(errors).toEqual([]);
});
"
`;

