# ShakeFix intake — example config. NO REAL SECRETS HERE.
# In Cloud Run, secrets come from Secret Manager (GITLAB_HUMAN_PAT, VAPID_PRIVATE_KEY, ...).

PORT=8080

# --- SCM provider (docs/PROVIDERS.md) ---------------------------------------------
# gitlab (default) | github. GitHub needs the image built from the repo root
# (templates/github/intake.Dockerfile) and: GITHUB_REPO=owner/name, GITHUB_TOKEN=...
# SCM_PROVIDER=gitlab

# --- GitLab ---------------------------------------------------------------------
GITLAB_URL=https://gitlab.com
# numeric id or url-encoded path, e.g. 12345678 or my-group/shakefix (shakefix-live after Oct 26)
GITLAB_PROJECT_ID=my-group/shakefix
# Maintainer's PERSONAL access token (scope: api). Human actor so Duo triggers fire. Rotate after judging.
GITLAB_HUMAN_PAT=glpat-xxxxxxxxxxxxxxxxxxxx
# Secret configured on the project webhook (sent as X-Gitlab-Token)
GITLAB_WEBHOOK_SECRET=change-me-webhook-secret
# Optional: branch for reports/<rid>/replay.json commits (default: project default branch)
REPORTS_REF=

# --- CI -> intake ---------------------------------------------------------------
# Shared with CI variable INTAKE_HOOK_SECRET; HMAC-SHA256 of the raw body in x-shakefix-signature
INTAKE_HOOK_SECRET=change-me-hook-secret

# --- Duo flow -------------------------------------------------------------------
# Flow service account username (with or without @), e.g. ai-shakefix-my-group
FLOW_SERVICE_ACCOUNT=ai-shakefix-my-group
# trigger (default: issue creation fires "Work item created") | api (POST /api/v4/ai/duo_workflows/workflows)
START_MODE=trigger
# custom flow id / definition used when START_MODE=api
FLOW_DEFINITION=

# --- Storage --------------------------------------------------------------------
# memory (default) | firestore
STORE=memory
FIRESTORE_COLLECTION=reports

# --- Reporter notification --------------------------------------------------------
# poll (default, no push library) | webpush (uses web-push, MPL-2.0)
PUSH_MODE=poll
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:maintainer@example.com

# --- HTTP -----------------------------------------------------------------------
# Public base URL of this intake; used to build the verdict URL in "Fixed" pushes
# (default: derived from the request, honouring X-Forwarded-Proto/Host)
PUBLIC_URL=https://intake-xxxxx.a.run.app
# comma-separated origins allowed to POST reports / read status (use * only in dev)
ALLOWED_ORIGINS=https://splitpal-xxxxx.a.run.app,http://localhost:5173

# --- Optional tuning --------------------------------------------------------------
# INPUT_ALLOWLIST=total-input,tip-select,currency-select
# MAX_BODY_BYTES=2097152
# RATE_IP_PER_MIN=5
# RATE_APP_PER_DAY=50
# MAX_REOPERATIONS=1
# LOG_LEVEL=info

# --- Timeline / demo (docs/DEMO.md) -------------------------------------------------
# Extra usernames that count as bots for "Human touches" (flow service account is always a bot)
# BOT_USERNAMES=shakefix-bot,project_123_bot
# DEMO_MODE=1 replays the recorded hero run (issue #4 -> MR !1) with real-time pacing; no GitLab calls.
# DEMO_MODE=0
# DEMO_SPEED=1
# Medical Record (docs/MEMORY.md): a reporter's 👎 appends a lesson to .shakefix/memory/lessons.md on the
# default branch ([skip ci]). On by default; MEMORY_LESSONS=0 turns it off.
# MEMORY_LESSONS=1

# --- Discharge Certificate (GET /v1/reports/:rid/certificate) ----------------------
# HMAC-SHA256 key that signs certificate digests (Secret Manager in Cloud Run). Unset: certificates
# are issued with signature null / signed:false and /v1/certificates/verify answers valid:false.
# CERT_SIGNING_KEY=change-me-cert-signing-key
# Optional web URL of the GitLab project for issue/MR links (default: derived from the issue URL).
# GITLAB_PROJECT_WEB_URL=https://gitlab.com/my-group/shakefix
